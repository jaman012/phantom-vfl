{
  "schema_version": 1,
  "name": "bank_marketing",
  "output_name": "bank_marketing",
  "files": {
    "cleaned_csv": "02_bank_marketing_cleaned/bank_marketing_cleaned.csv",
    "train_csv": "bank_marketing_train.csv"
  },
  "label": {
    "column": "label",
    "map": {"0": 0, "1": 1},
